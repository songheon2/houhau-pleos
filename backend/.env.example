# Server settings. Copy to backend/.env and fill in the values; backend/.env is git-ignored and never
# committed. Local runs read the root .env instead (see .env.example). Values already set in the
# process environment (systemd, PowerShell $env:) win over this file.

# ---- External API keys ---------------------------------------------------------------------
# Kakao Local REST API key (place search). Empty -> demo points.
KAKAO_REST_API_KEY=
# Optional. API Hub key with 'AWS 매분자료' and '지점정보' applied for. Rain from the nearest station,
# renewed every couple of minutes. Empty or failing -> hourly rain with the key below.
KMA_AWS_KEY=
# KMA key from apihub.kma.go.kr or data.go.kr (hourly rainfall, heavy-rain alerts). Empty -> demo weather.
KMA_SERVICE_KEY=

# ---- Spoken guidance (Supertonic 3) ---------------------------------------------------------
# Loopback-only Supertonic service on the same machine. Empty URL -> the screen uses the browser's
# own voice.
HOUHAU_TTS_URL=http://127.0.0.1:7788
# F1 = built-in female voice 1 ("Sarah"). F2 = "Lily".
HOUHAU_TTS_VOICE=F1
HOUHAU_TTS_SPEED=1.05
HOUHAU_TTS_TIMEOUT_S=10

# ---- Routing -------------------------------------------------------------------------------
# Valhalla config path. Empty -> .local-data/valhalla/valhalla.json
VALHALLA_CONFIG=
# Route request time limit in seconds. Empty -> strategies.yaml engine.timeout_s (10)
ROUTING_TIMEOUT_S=
