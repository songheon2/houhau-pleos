# Local development only: copy to .env, read by scripts/dev-backend-conda.ps1. A server reads backend/.env
# instead (all settings are listed in backend/.env.example). .env is git-ignored; do not commit real keys.
# Kakao REST API key. Empty: demo points only.
KAKAO_REST_API_KEY=
# Optional. API Hub key with 'AWS 매분자료' and '지점정보' applied for. Per-minute rain instead of hourly.
KMA_AWS_KEY=
# KMA key from apihub.kma.go.kr or data.go.kr. Empty: demo weather only.
KMA_SERVICE_KEY=
# Optional. Spoken guidance server; empty uses the browser's own voice (no wait for a missing server).
HOUHAU_TTS_URL=
